# --- Experiment outputs -------------------------------------------------------
# Result data under results/ is tracked: it is what the paper reports.
# Everything else an experiment writes there (trained adapter weights,
# tokenizer copies, cached tensors, logs, resume state) is large and can be
# regenerated, so only data files are let through.
results/*
!results/*/
!results/*.json
!results/*.csv
!results/*.md
results/*/*
!results/*/*.json
!results/*/*.csv
!results/*/*.md
results/**/checkpoint.jsonl

# Model weights and tensors, wherever they end up.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.npz
*.npy
*.pkl
*.h5

# Run logs and experiment trackers.
*.log
wandb/
mlruns/
lightning_logs/
outputs/
checkpoints/

# Model and dataset caches created inside the repo.
.cache/
huggingface/
hf_cache/
data/
datasets/
cifar-10-batches-py/
*.tar.gz

